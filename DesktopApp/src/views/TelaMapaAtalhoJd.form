        <Component class="javax.swing.JLabel" name="jLabel1">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="Arial" size="17" style="0"/>
            </Property>
            <Property name="text" type="java.lang.String" value="&lt;html&gt; &lt;body style=&quot;font-family: sans-serif; font-size: 12px; color: #333; margin: 0; padding: 10px;&quot;&gt;   &lt;h2 style=&quot;font-size: 18px; margin-top: 0; border-bottom: 1px solid #ccc; padding-bottom: 5px;&quot;&gt;&#x2328;&#xfe0f; Guia de Atalhos do Sistema&lt;/h2&gt;    &lt;b&gt;\ud83e\udded Navega&#xe7;&#xe3;o Geral e Autentica&#xe7;&#xe3;o&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;Tab:&lt;/b&gt; Move o foco entre os campos&lt;br&gt;   &amp;bull; &lt;b&gt;Enter / Espa&#xe7;o:&lt;/b&gt; Confirma a&#xe7;&#xf5;es e realiza o login&lt;br&gt;   &amp;bull; &lt;b&gt;Setas:&lt;/b&gt; Navega em menus e seleciona itens em tabelas&lt;br&gt;&lt;br&gt;    &lt;b&gt;\ud83d\udcc2 Menu Principal&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;F10:&lt;/b&gt; Abre e fecha o menu&lt;br&gt;   &amp;bull; &lt;b&gt;F2:&lt;/b&gt; Cargos&lt;br&gt;   &amp;bull; &lt;b&gt;F3:&lt;/b&gt; Processos&lt;br&gt;   &amp;bull; &lt;b&gt;F4:&lt;/b&gt; Recrutadores&lt;br&gt;   &amp;bull; &lt;b&gt;F6:&lt;/b&gt; Cadastro de Usu&#xe1;rios&lt;br&gt;   &amp;bull; &lt;b&gt;Esc:&lt;/b&gt; Sai do sistema&lt;br&gt;&lt;br&gt;    &lt;b&gt;\ud83d\udccb Gerenciamento (Tabelas)&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + N:&lt;/b&gt; Novo registro&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + E:&lt;/b&gt; Editar registro selecionado&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + D:&lt;/b&gt; Excluir registro selecionado&lt;br&gt;   &amp;bull; &lt;b&gt;Espa&#xe7;o:&lt;/b&gt; Abrir registro ou confirmar atribui&#xe7;&#xe3;o&lt;br&gt;&lt;br&gt;    &lt;b&gt;\ud83d\udcdd Formul&#xe1;rios de Cadastro / Edi&#xe7;&#xe3;o&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + Tab:&lt;/b&gt; Alterna entre campos de preenchimento&lt;br&gt;   &amp;bull; &lt;b&gt;Espa&#xe7;o / Enter:&lt;/b&gt; Salva e confirma o cadastro &lt;/body&gt; &lt;/html&gt;" containsInvalidXMLChars="true"/>
          </Properties>
