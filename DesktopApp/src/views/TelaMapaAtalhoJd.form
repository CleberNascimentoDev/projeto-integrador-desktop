              <Properties>
                <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                  <Font name="Arial" size="17" style="0" />
                </Property>
                <Property name="text" type="java.lang.String" value="&lt;html&gt; &lt;body style=&quot;font-family: sans-serif; font-size: 12px; color: #333; margin: 0; padding: 10px;&quot;&gt;   &lt;h2 style=&quot;font-size: 18px; margin-top: 0; border-bottom: 1px solid #ccc; padding-bottom: 5px;&quot;&gt;⌨️ Guia de Atalhos do Sistema&lt;/h2&gt;    &lt;b&gt;\ud83e\udded Navegação Geral e Autenticação&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;Tab:&lt;/b&gt; Move o foco entre os campos&lt;br&gt;   &amp;bull; &lt;b&gt;Enter / Espaço:&lt;/b&gt; Confirma ações e realiza o login&lt;br&gt;   &amp;bull; &lt;b&gt;Setas:&lt;/b&gt; Navega em menus e seleciona itens em tabelas&lt;br&gt;&lt;br&gt;    &lt;b&gt;\ud83d\udcc2 Menu Principal&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;F10:&lt;/b&gt; Abre e fecha o menu&lt;br&gt;   &amp;bull; &lt;b&gt;F2:&lt;/b&gt; Cargos&lt;br&gt;   &amp;bull; &lt;b&gt;F3:&lt;/b&gt; Processos&lt;br&gt;   &amp;bull; &lt;b&gt;F4:&lt;/b&gt; Recrutadores&lt;br&gt;   &amp;bull; &lt;b&gt;F6:&lt;/b&gt; Cadastro de Usuários&lt;br&gt;   &amp;bull; &lt;b&gt;Esc:&lt;/b&gt; Sai do sistema&lt;br&gt;&lt;br&gt;    &lt;b&gt;\ud83d\udccb Gerenciamento (Tabelas)&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + N:&lt;/b&gt; Novo registro&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + E:&lt;/b&gt; Editar registro selecionado&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + D:&lt;/b&gt; Excluir registro selecionado&lt;br&gt;   &amp;bull; &lt;b&gt;Espaço:&lt;/b&gt; Abrir registro ou confirmar atribuição&lt;br&gt;&lt;br&gt;    &lt;b&gt;\ud83d\udcdd Formulários de Cadastro / Edição&lt;/b&gt;&lt;br&gt;   &amp;bull; &lt;b&gt;Ctrl + Tab:&lt;/b&gt; Alterna entre campos de preenchimento&lt;br&gt;   &amp;bull; &lt;b&gt;Espaço / Enter:&lt;/b&gt; Salva e confirma o cadastro &lt;/body&gt; &lt;/html&gt;" containsInvalidXMLChars="true" />
