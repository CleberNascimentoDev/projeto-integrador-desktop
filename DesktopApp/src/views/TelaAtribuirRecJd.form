            <Component class="classes.BotaoAjuda" name="botaoAjuda">
              <Properties>
                <Property name="textoAjuda" type="java.lang.String" value="Esta é a tela de Selecionar Recrutador do sistema MAINRH, dedicada à vinculação de um responsável a um processo seletivo específico. No topo, confirme as informações do **Processo** e da **Data** correspondentes. Utilize a barra de busca para pesquisar um recrutador cadastrado pelo nome ou e-mail. Na tabela inferior, selecione o profissional desejado da lista contendo **Nome** e **E-mail** e clique no botão **Atribuir** para concluir a vinculação, ou no botão **Cancelar** para fechar a janela sem salvar." />
                <Property name="preferredSize" type="java.awt.Dimension" editor="org.netbeans.beaninfo.editors.DimensionEditor">
                  <Dimension value="[42, 42]" />
                </Property>
              </Properties>
              <Constraints>
                <Constraint layoutClass="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout" value="org.netbeans.modules.form.compat2.layouts.DesignBorderLayout$BorderConstraintsDescription">
                  <BorderConstraints direction="East" />
                </Constraint>
              </Constraints>
            </Component>
